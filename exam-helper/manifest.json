{
  "manifest_version": 3,
  "name": "exam-helper",
  "version": "1.3.4",
  "description": "任意网页划词识题：题库匹配 + DeepSeek 兜底；内置多场景模拟练习",
  "icons": {
    "16": "icons/active/icon-16.png",
    "32": "icons/active/icon-32.png",
    "48": "icons/active/icon-48.png",
    "128": "icons/active/icon-128.png"
  },
  "permissions": ["storage", "activeTab", "scripting", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "exam-helper",
    "default_icon": {
      "16": "icons/inactive/icon-16.png",
      "32": "icons/inactive/icon-32.png",
      "48": "icons/inactive/icon-48.png",
      "128": "icons/inactive/icon-128.png"
    },
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/bootstrap.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/assist/*.js",
        "content/selection/*.js",
        "shared/ui/*.js",
        "shared/ui/*.css",
        "shared/utils/*.js",
        "data/*.js",
        "fixtures/*",
        "materials/*",
        "practice/app/*.js",
        "practice/core/*.js",
        "practice/ui/*.js",
        "practice/input/*.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "toggle-enable": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "启用/禁用划词助手"
    },
    "ask-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+A",
        "mac": "Ctrl+Shift+A"
      },
      "description": "查询当前选区答案（⌃⇧A；页面内直接按也可）"
    }
  }
}
