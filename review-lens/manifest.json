{
  "manifest_version": 3,
  "name": "review-lens",
  "version": "2.1.0",
  "description": "在 GitLab MR 讨论页并排看「评论时的代码」与「修正后的代码」",
  "icons": {
    "16": "icons/active/icon-16.png",
    "32": "icons/active/icon-32.png",
    "48": "icons/active/icon-48.png",
    "128": "icons/active/icon-128.png"
  },
  "action": {
    "default_title": "review-lens",
    "default_icon": {
      "16": "icons/inactive/icon-16.png",
      "32": "icons/inactive/icon-32.png",
      "48": "icons/inactive/icon-48.png",
      "128": "icons/inactive/icon-128.png"
    },
    "default_popup": "popup/popup.html"
  },
  "permissions": ["storage", "scripting"],
  "optional_host_permissions": ["*://*/*"],
  "content_scripts": [
    {
      "matches": [
        "http://git.dev.sh.ctripcorp.com/*",
        "https://git.dev.sh.ctripcorp.com/*",
        "https://gitlab.com/*"
      ],
      "js": ["content/bootstrap.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/*.js",
        "core/*.js",
        "core/*/*.js",
        "ui/*.js",
        "ui/*/*.js",
        "ui/*.css",
        "ui/tokens.css"
      ],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "popup/settings.html"
}
