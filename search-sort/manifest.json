{
  "manifest_version": 3,
  "name": "Search Params Sorter",
  "version": "2.0.0",
  "description": "Sort URL search params and set defaults for any website",
  "icons": {
    "16": "icons/active/icon-16.png",
    "32": "icons/active/icon-32.png",
    "48": "icons/active/icon-48.png",
    "128": "icons/active/icon-128.png"
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["content/*.js", "utils/*.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/inactive/icon-16.png",
      "32": "icons/inactive/icon-32.png",
      "48": "icons/inactive/icon-48.png",
      "128": "icons/inactive/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/bootstrap.js"],
      "run_at": "document_end"
    }
  ]
}
